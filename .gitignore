# Local AppData backup of third-party add-ins (not part of this project)
_AppdataBackup/

# Installer binaries and Inno Setup build output
*.exe
build/Output/

# Large design sources (kept out of the distribution repo)
Logos/*.psd
Logos/*.psb

# Every .ppam is a local build input or an archived copy EXCEPT the distributable.
# (Applies in any folder, so an "Archive" folder of old builds stays out of git.)
*.ppam
!dist/TrialQuest.ppam

# Working PowerPoint macro files (you version-name them). The git-tracked source
# is the exported Modules/*.bas + Forms/*; rebuild the .ppam from your local .pptm.
*.pptm

# Update staging that may appear if you test the swapper locally
**/_staging/

# Redundant loose copy at root (canonical copy lives under assets/)
/CalendarTemplate.pptx

# Office lock/owner files (created while a doc is open)
~$*

# OS / editor cruft
Thumbs.db
.DS_Store
